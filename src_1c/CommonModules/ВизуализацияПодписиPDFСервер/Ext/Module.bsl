#Область ПрограммныйИнтерфейс

// Возвращает настройки запуска обработчика PDF.
// Пути должны быть доступны учетной записи рабочего процесса сервера 1С.
Функция НовыеНастройки(ПутьPython, ПутьСкрипта) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ПутьPython", ПутьPython);
	Настройки.Вставить("ПутьСкрипта", ПутьСкрипта);
	Настройки.Вставить("Страницы", "all");
	Настройки.Вставить("ДоляШириныШтампа", 0.49);
	Настройки.Вставить("ВысотаШтампа", 100);
	Настройки.Вставить("ОтступСлева", 40);
	Настройки.Вставить("ОтступСнизу", 60);
	Настройки.Вставить("Позиция", "bottom_left");
	Настройки.Вставить("ПутьШрифта", "");

	Возврат Настройки;

КонецФункции

// Возвращает обезличенный контракт данных штампа.
// Получение сертификата и МЧД зависит от версии конфигурации и выполняется вызывающим кодом.
Функция НовыеДанныеШтампа(
	ОтпечатокСертификата,
	ВладелецСертификата,
	ДействителенДо,
	НомерДоверенности) Экспорт

	Если ТипЗнч(ДействителенДо) = Тип("Дата") Тогда
		ПредставлениеСрока = Формат(ДействителенДо, "ДФ=dd.MM.yyyy");
	Иначе
		ПредставлениеСрока = СокрЛП(Строка(ДействителенДо));
	КонецЕсли;

	ДанныеШтампа = Новый Структура;
	ДанныеШтампа.Вставить("ОтпечатокСертификата", СокрЛП(Строка(ОтпечатокСертификата)));
	ДанныеШтампа.Вставить("ВладелецСертификата", СокрЛП(Строка(ВладелецСертификата)));
	ДанныеШтампа.Вставить("СрокДействияСертификата", ПредставлениеСрока);
	ДанныеШтампа.Вставить("НомерДоверенности", СокрЛП(Строка(НомерДоверенности)));

	Возврат ДанныеШтампа;

КонецФункции

// Добавляет штамп в PDF, находящийся во временном хранилище.
// Для файлов других типов возвращает исходный адрес без изменений.
Функция ДобавитьШтампВоВременноеХранилище(
	АдресPDF,
	ПредставлениеФайла,
	ДанныеШтампа,
	Настройки,
	Исполнитель = Неопределено) Экспорт

	Если Не ЭтоPDF(ПредставлениеФайла) Тогда
		Возврат АдресPDF;
	КонецЕсли;

	Если ПустаяСтрока(АдресPDF) Тогда
		ВызватьИсключение "Не указан адрес PDF во временном хранилище.";
	КонецЕсли;

	ДвоичныеДанныеPDF = ПолучитьИзВременногоХранилища(АдресPDF);
	Если ТипЗнч(ДвоичныеДанныеPDF) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Во временном хранилище отсутствуют двоичные данные PDF.";
	КонецЕсли;

	Результат = ДобавитьШтампВДвоичныеДанные(ДвоичныеДанныеPDF, ДанныеШтампа, Настройки, Исполнитель);
	Возврат ПоместитьВоВременноеХранилище(Результат, АдресPDF);

КонецФункции

// Добавляет штамп в переданные двоичные данные PDF и возвращает новые двоичные данные.
Функция ДобавитьШтампВДвоичныеДанные(
	ДвоичныеДанныеPDF,
	ДанныеШтампа,
	Настройки,
	Исполнитель = Неопределено) Экспорт

	ПроверитьВходныеДанные(ДвоичныеДанныеPDF, ДанныеШтампа, Настройки);

	ВходнойPDF = ПолучитьИмяВременногоФайла("pdf");
	ВыходнойPDF = ПолучитьИмяВременногоФайла("pdf");
	ФайлЗадания = ПолучитьИмяВременногоФайла("json");

	ВременныеФайлы = Новый Массив;
	ВременныеФайлы.Добавить(ВходнойPDF);
	ВременныеФайлы.Добавить(ВыходнойPDF);
	ВременныеФайлы.Добавить(ФайлЗадания);

	Результат = Неопределено;
	ТекстОшибки = "";

	Попытка
		ДвоичныеДанныеPDF.Записать(ВходнойPDF);
		Задание = СоздатьЗадание(ВходнойPDF, ВыходнойPDF, ДанныеШтампа, Настройки);
		ЗаписатьЗаданиеJSON(ФайлЗадания, Задание);

		Аргументы = Новый Массив;
		Аргументы.Добавить("--config");
		Аргументы.Добавить(ФайлЗадания);

		РезультатКоманды = ВыполнитьPython(Настройки, Аргументы, Исполнитель);
		Если РезультатКоманды.КодВозврата <> 0 Тогда
			ТекстPython = РезультатКоманды.Ошибки;
			Если ПустаяСтрока(ТекстPython) Тогда
				ТекстPython = РезультатКоманды.Вывод;
			КонецЕсли;
			ВызватьИсключение СтрШаблон(
				"Python завершился с кодом %1. %2",
				РезультатКоманды.КодВозврата,
				ТекстPython);
		КонецЕсли;

		ФайлРезультата = Новый Файл(ВыходнойPDF);
		Если Не ФайлРезультата.Существует() Тогда
			ВызватьИсключение "Python не создал выходной PDF.";
		КонецЕсли;

		Результат = Новый ДвоичныеДанные(ВыходнойPDF);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ОшибкаОчистки = УдалитьВременныеФайлы(ВременныеФайлы);
	Если Не ПустаяСтрока(ОшибкаОчистки) Тогда
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ОшибкаОчистки;
		Иначе
			ТекстОшибки = ТекстОшибки + Символы.ПС + "Ошибка очистки: " + ОшибкаОчистки;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обрабатывает независимые элементы пакета. Каждый элемент содержит Ключ, ДвоичныеДанныеPDF и ДанныеШтампа.
Функция ДобавитьШтампыПакетом(
	Элементы,
	Настройки,
	ОстановитьПриОшибке = Истина,
	Исполнитель = Неопределено) Экспорт

	Результаты = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Попытка
			ДанныеРезультата = ДобавитьШтампВДвоичныеДанные(
				Элемент.ДвоичныеДанныеPDF,
				Элемент.ДанныеШтампа,
				Настройки,
				Исполнитель);
			Результаты.Добавить(Новый Структура(
				"Ключ,Успешно,ДвоичныеДанные,ОписаниеОшибки",
				Элемент.Ключ,
				Истина,
				ДанныеРезультата,
				""));
		Исключение
			Результаты.Добавить(Новый Структура(
				"Ключ,Успешно,ДвоичныеДанные,ОписаниеОшибки",
				Элемент.Ключ,
				Ложь,
				Неопределено,
				ОписаниеОшибки()));
			Если ОстановитьПриОшибке Тогда
				Прервать;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Проверяет доступность Python, скрипта и PyMuPDF без обработки документа.
Функция ПроверитьОкружение(Настройки, Исполнитель = Неопределено) Экспорт

	Результат = Новый Структура("Успешно,Сообщение", Ложь, "");

	Попытка
		ПроверитьНастройки(Настройки);
		Аргументы = Новый Массив;
		Аргументы.Добавить("--version");
		РезультатКоманды = ВыполнитьPython(Настройки, Аргументы, Исполнитель);

		Если РезультатКоманды.КодВозврата = 0 Тогда
			Результат.Успешно = Истина;
			Результат.Сообщение = СокрЛП(РезультатКоманды.Вывод);
		Иначе
			Результат.Сообщение = СокрЛП(РезультатКоманды.Ошибки);
		КонецЕсли;
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает Истина только для имени файла с расширением PDF без учета регистра.
Функция ЭтоPDF(ПредставлениеФайла) Экспорт
	ИмяФайла = СокрЛП(Строка(ПредставлениеФайла));
	Возврат СтрДлина(ИмяФайла) >= 4 И НРег(Прав(ИмяФайла, 4)) = ".pdf";
КонецФункции

#КонецОбласти

#Область ВнутренниеПроцедурыИФункции

Процедура ПроверитьВходныеДанные(ДвоичныеДанныеPDF, ДанныеШтампа, Настройки)

	Если ТипЗнч(ДвоичныеДанныеPDF) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Ожидались двоичные данные PDF.";
	КонецЕсли;

	ПроверитьДанныеШтампа(ДанныеШтампа);
	ПроверитьНастройки(Настройки);

КонецПроцедуры

Процедура ПроверитьДанныеШтампа(ДанныеШтампа)

	Если ТипЗнч(ДанныеШтампа) <> Тип("Структура") Тогда
		ВызватьИсключение "Данные штампа должны иметь тип Структура.";
	КонецЕсли;

	ПроверитьОбязательноеСвойство(ДанныеШтампа, "ОтпечатокСертификата");
	ПроверитьОбязательноеСвойство(ДанныеШтампа, "ВладелецСертификата");
	ПроверитьОбязательноеСвойство(ДанныеШтампа, "СрокДействияСертификата");
	ПроверитьОбязательноеСвойство(ДанныеШтампа, "НомерДоверенности");

КонецПроцедуры

Процедура ПроверитьНастройки(Настройки)

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение "Настройки должны иметь тип Структура.";
	КонецЕсли;

	ПроверитьОбязательноеСвойство(Настройки, "ПутьPython");
	ПроверитьОбязательноеСвойство(Настройки, "ПутьСкрипта");
	ПроверитьОбязательноеСвойство(Настройки, "Страницы");
	ПроверитьОбязательноеСвойство(Настройки, "ДоляШириныШтампа");
	ПроверитьОбязательноеСвойство(Настройки, "ВысотаШтампа");
	ПроверитьОбязательноеСвойство(Настройки, "ОтступСлева");
	ПроверитьОбязательноеСвойство(Настройки, "ОтступСнизу");
	ПроверитьОбязательноеСвойство(Настройки, "Позиция");

	ПроверитьСуществованиеФайла(Настройки.ПутьPython, "Интерпретатор Python");
	ПроверитьСуществованиеФайла(Настройки.ПутьСкрипта, "Скрипт обработки PDF");

	ПроверитьСтраницы(Настройки.Страницы);

	Если Настройки.Позиция <> "bottom_left"
		И Настройки.Позиция <> "bottom_right"
		И Настройки.Позиция <> "top_left"
		И Настройки.Позиция <> "top_right" Тогда
		ВызватьИсключение "Настройка Позиция содержит недопустимое значение.";
	КонецЕсли;

	Если Настройки.ДоляШириныШтампа <= 0 Или Настройки.ДоляШириныШтампа > 1 Тогда
		ВызватьИсключение "Доля ширины штампа должна быть больше 0 и не больше 1.";
	КонецЕсли;

	Если Настройки.ВысотаШтампа <= 0 Тогда
		ВызватьИсключение "Высота штампа должна быть больше 0.";
	КонецЕсли;

	Если Настройки.ОтступСлева < 0 Или Настройки.ОтступСнизу < 0 Тогда
		ВызватьИсключение "Отступы штампа не могут быть отрицательными.";
	КонецЕсли;

	ЕстьКоординатаX = Настройки.Свойство("КоординатаX");
	ЕстьКоординатаY = Настройки.Свойство("КоординатаY");
	Если ЕстьКоординатаX <> ЕстьКоординатаY Тогда
		ВызватьИсключение "Координаты X и Y должны быть указаны вместе.";
	КонецЕсли;
	Если ЕстьКоординатаX И (Настройки.КоординатаX < 0 Или Настройки.КоординатаY < 0) Тогда
		ВызватьИсключение "Координаты штампа не могут быть отрицательными.";
	КонецЕсли;

	Если Настройки.Свойство("ПутьШрифта") И Не ПустаяСтрока(Настройки.ПутьШрифта) Тогда
		ПроверитьСуществованиеФайла(Настройки.ПутьШрифта, "Файл шрифта");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтраницы(Страницы)

	Если ТипЗнч(Страницы) = Тип("Строка") Тогда
		Если Страницы <> "all" И Страницы <> "first" И Страницы <> "last" Тогда
			ВызватьИсключение "Страницы должны иметь значение all, first или last.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Страницы) <> Тип("Массив") Тогда
		ВызватьИсключение "Страницы должны быть строкой или массивом номеров.";
	КонецЕсли;
	Если Страницы.Количество() = 0 Тогда
		ВызватьИсключение "Страницы должны быть строкой или непустым массивом номеров.";
	КонецЕсли;
	УникальныеНомера = Новый Соответствие;
	Для Каждого НомерСтраницы Из Страницы Цикл
		Если ТипЗнч(НомерСтраницы) <> Тип("Число") Или НомерСтраницы < 1 Или НомерСтраницы <> Цел(НомерСтраницы) Тогда
			ВызватьИсключение "Номера страниц должны быть положительными целыми числами.";
		КонецЕсли;
		Если УникальныеНомера.Получить(НомерСтраницы) <> Неопределено Тогда
			ВызватьИсключение "Номера страниц не должны повторяться.";
		КонецЕсли;
		УникальныеНомера.Вставить(НомерСтраницы, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательноеСвойство(Значение, ИмяСвойства)
	Если Не Значение.Свойство(ИмяСвойства) Или Не ЗначениеЗаполнено(Значение[ИмяСвойства]) Тогда
		ВызватьИсключение "Не заполнено обязательное свойство " + ИмяСвойства + ".";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСуществованиеФайла(ИмяФайла, ОписаниеФайла)
	ПроверяемыйФайл = Новый Файл(ИмяФайла);
	Если Не ПроверяемыйФайл.Существует() Тогда
		ВызватьИсключение ОписаниеФайла + " не найден: " + ИмяФайла;
	КонецЕсли;
КонецПроцедуры

Функция СоздатьЗадание(ВходнойPDF, ВыходнойPDF, ДанныеШтампа, Настройки)

	Задание = Новый Структура;
	Задание.Вставить("input_pdf", ВходнойPDF);
	Задание.Вставить("output_pdf", ВыходнойPDF);
	Задание.Вставить("certificate", ДанныеШтампа.ОтпечатокСертификата);
	Задание.Вставить("owner", ДанныеШтампа.ВладелецСертификата);
	Задание.Вставить("valid_until", ДанныеШтампа.СрокДействияСертификата);
	Задание.Вставить("power_of_attorney", ДанныеШтампа.НомерДоверенности);
	Задание.Вставить("pages", Настройки.Страницы);
	Задание.Вставить("stamp_width_ratio", Настройки.ДоляШириныШтампа);
	Задание.Вставить("stamp_height", Настройки.ВысотаШтампа);
	Задание.Вставить("left_margin", Настройки.ОтступСлева);
	Задание.Вставить("bottom_margin", Настройки.ОтступСнизу);
	Задание.Вставить("position", Настройки.Позиция);

	Если Настройки.Свойство("КоординатаX") Тогда
		Задание.Вставить("stamp_x", Настройки.КоординатаX);
		Задание.Вставить("stamp_y", Настройки.КоординатаY);
	КонецЕсли;

	Если Настройки.Свойство("ПутьШрифта") И Не ПустаяСтрока(Настройки.ПутьШрифта) Тогда
		Задание.Вставить("font_path", Настройки.ПутьШрифта);
	КонецЕсли;

	Возврат Задание;

КонецФункции

Процедура ЗаписатьЗаданиеJSON(ИмяФайла, Задание)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьОткрыта = Ложь;

	Попытка
		ЗаписьJSON.ОткрытьФайл(ИмяФайла, КодировкаТекста.UTF8);
		ЗаписьОткрыта = Истина;
		ЗаписатьJSON(ЗаписьJSON, Задание);
		ЗаписьJSON.Закрыть();
	Исключение
		Если ЗаписьОткрыта Тогда
			Попытка
				ЗаписьJSON.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ВыполнитьPython(Настройки, Аргументы, Исполнитель = Неопределено)

	Если Исполнитель <> Неопределено Тогда
		// Адаптер получает только настройки и массив аргументов, чтобы его можно было заменить в тестах.
		Возврат Исполнитель.Выполнить(Настройки, Аргументы);
	КонецЕсли;

	ФайлСтандартногоВывода = ПолучитьИмяВременногоФайла("log");
	ФайлОшибок = ПолучитьИмяВременногоФайла("log");
	ВременныеФайлы = Новый Массив;
	ВременныеФайлы.Добавить(ФайлСтандартногоВывода);
	ВременныеФайлы.Добавить(ФайлОшибок);

	Результат = Новый Структура("КодВозврата,Вывод,Ошибки", -1, "", "");
	ТекстОшибки = "";

	Попытка
		КомандаPython = ВКавычках(Настройки.ПутьPython) + " -X utf8 " + ВКавычках(Настройки.ПутьСкрипта);
		Для Каждого Аргумент Из Аргументы Цикл
			КомандаPython = КомандаPython + " " + ВКавычках(Строка(Аргумент));
		КонецЦикла;

		КомандаPython = КомандаPython
			+ " 1> " + ВКавычках(ФайлСтандартногоВывода)
			+ " 2> " + ВКавычках(ФайлОшибок);

		Команда = "cmd.exe /D /S /C " + ВКавычках(КомандаPython);
		Shell = Новый COMОбъект("WScript.Shell");
		Результат.КодВозврата = Shell.Run(Команда, 0, Истина);
		Результат.Вывод = ПрочитатьТекстовыйФайл(ФайлСтандартногоВывода);
		Результат.Ошибки = ПрочитатьТекстовыйФайл(ФайлОшибок);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ОшибкаОчистки = УдалитьВременныеФайлы(ВременныеФайлы);
	Если Не ПустаяСтрока(ОшибкаОчистки) Тогда
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ОшибкаОчистки;
		Иначе
			ТекстОшибки = ТекстОшибки + Символы.ПС + "Ошибка очистки: " + ОшибкаОчистки;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВКавычках(Значение)
	Возврат """" + Значение + """";
КонецФункции

Функция ПрочитатьТекстовыйФайл(ИмяФайла)
	ПроверяемыйФайл = Новый Файл(ИмяФайла);
	Если Не ПроверяемыйФайл.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

Функция УдалитьВременныеФайлы(ИменаФайлов)

	Ошибки = Новый Массив;
	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		ПроверяемыйФайл = Новый Файл(ИмяФайла);
		Если ПроверяемыйФайл.Существует() Тогда
			Попытка
				УдалитьФайлы(ИмяФайла);
			Исключение
				Ошибки.Добавить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

#КонецОбласти
